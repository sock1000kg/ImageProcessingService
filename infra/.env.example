# Copy to infra/.env (gitignored) and adjust as you like.
# Only used by infra/docker-compose.yaml for local development.

MINIO_ROOT_USER=imgproclocal
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_local

POSTGRES_PASSWORD=CHANGE_ME_imgproc_local

# Signs the web app's login tokens (32+ characters; default: a fixed local-only value). E.g. `openssl rand -hex 32`.
JWT_SECRET=CHANGE_ME_local_jwt_secret_at_least_32_chars
# Key the sign-up page asks for (default "local").
REGISTER_KEY=local
