PORT=3000
DATABASE_URL=postgresql://imgproc:CHANGE_ME_imgproc_local@localhost:5432/imgproc
NATS_URL=nats://localhost:4222
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=imgproclocal
MINIO_SECRET_KEY=CHANGE_ME_minio_local
MINIO_USE_SSL=false
S3_PUBLIC_ENDPOINT=http://localhost:9000
PRESIGN_RESULT_TTL_SECONDS=3600
PRESIGN_PRIVATE_TTL_SECONDS=300
IMAGE_UPLOAD_MAX_BYTES=52428800
# Videos are sent in chunks, so their limit is separate and can be much larger than a photo's.
VIDEO_UPLOAD_MAX_BYTES=209715200
UPLOAD_CHUNK_BYTES=8388608
VIDEO_MIN_DURATION_SECONDS=15
VIDEO_MAX_DURATION_SECONDS=60
BATCH_MAX_FILES=1000
# General rate limit multiplier scaling login, refresh and allow list creation (1 = defaults, > 1 for load tests, < 1 stricter)
RATE_LIMIT_MULTIPLIER=1
# Transfer rate limit multiplier scaling batch creation, file uploads, and zip downloads (1 = defaults, > 1 for load tests)
TRANSFER_RATE_LIMIT_MULTIPLIER=1
CLEANUP_INTERVAL_MS=600000
RETENTION_DAYS=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800
REGISTER_KEY=change-this-team-registration-key
COOKIE_SECURE=false
CLIENT_IP_HEADER=
