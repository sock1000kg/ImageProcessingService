generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED

  @@map("job_status")
}

model Batch {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  name               String    @db.VarChar(100)
  config             Json
  whitelistKeys      String[]  @default([]) @map("whitelist_keys")
  whitelistNames     Json      @default("{}") @map("whitelist_names")
  whitelistDeletedAt DateTime? @map("whitelist_deleted_at") @db.Timestamptz
  deleteRequestedAt  DateTime? @map("delete_requested_at") @db.Timestamptz
  startedAt          DateTime? @map("started_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  jobs               Job[]
  uploadSessions     UploadSession[]
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt(sort: Desc)], map: "idx_batches_created_at")
  @@index([userId, createdAt(sort: Desc)], map: "idx_batches_user_created_at")
  @@map("batches")
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique @db.VarChar(320)
  passwordHash  String         @map("password_hash")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  batches       Batch[]
  refreshTokens RefreshToken[]
  faceLists     FaceList[]
  uploadSessions UploadSession[]

  @@map("users")
}

model FaceList {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  name      String   @db.VarChar(100)
  keys      String[] @default([])
  faceNames Json     @default("{}") @map("face_names")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)], map: "idx_face_lists_user_created_at")
  @@map("face_lists")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Job {
  id               String    @id @default(uuid()) @db.Uuid
  batchId          String    @map("batch_id") @db.Uuid
  originalFilename String    @map("original_filename")
  inputKey         String    @map("input_key")
  outputKey        String    @map("output_key")
  inputBytes       Int?      @map("input_bytes")
  resultBytes      Int?      @map("result_bytes")
  status           JobStatus @default(PENDING)
  progress         Int       @default(0)
  stage            String?
  resultSummary    Json?     @map("result_summary")
  error            Json?
  whitelistRefs    Int[]     @default([]) @map("whitelist_refs")
  replacesJobId    String?   @map("replaces_job_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  batch            Batch     @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId], map: "idx_jobs_batch_id")
  @@index([status], map: "idx_jobs_status")
  @@index([createdAt(sort: Desc)], map: "idx_jobs_created_at")
  @@index([replacesJobId], map: "idx_jobs_replaces_job_id")
  @@map("jobs")
}

model UploadSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  batchId    String   @map("batch_id") @db.Uuid
  objectKey  String   @map("object_key")
  filename   String
  contentType String  @map("content_type")
  totalBytes Int      @map("total_bytes")
  uploadId   String   @map("upload_id")
  // Moves forward each time a part arrives, so the cleanup can tell an upload still in progress from a dead one.
  lastActivityAt DateTime @default(now()) @map("last_activity_at") @db.Timestamptz

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([lastActivityAt])
  @@map("upload_sessions")
}
