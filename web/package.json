{
  "name": "image-processing-web",
  "private": true,
  "scripts": {
    "pretest": "prisma generate",
    "pretest:backend": "prisma generate",
    "pretest:service": "prisma generate",
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "prisma generate && tsc -p backend/tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "lint": "prisma generate && tsc -p backend/tsconfig.json --noEmit && tsc -p frontend/tsconfig.json",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "vitest run --config backend/vitest.config.ts",
    "test:service": "vitest run --config backend/vitest.service.config.ts",
    "test:frontend": "vitest run --config frontend/vitest.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "start": "node backend/dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@vitejs/plugin-react": "^4.3.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.0.2",
    "nats": "^2.29.2",
    "pg": "^8.13.1",
    "prisma": "^7.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "happy-dom": "^21.0.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5"
  }
}
